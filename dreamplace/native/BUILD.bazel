load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "placer",
    srcs = [
        "alignment.cpp",
        "align_snap.cpp",
        "cohesion.cpp",
        "centroid.cpp",
        "floorplan.cpp",
        "density_force.cpp",
        "density_map.cpp",
        "kernels.cpp",
        "local_density.cpp",
        "orientation.cpp",
        "placement.cpp",
        "rudy.cpp",
        "rudy_rsmt.cpp",
        "rudy_macro.cpp",
        "rudy_obstacles.cpp",
        "repulsion.cpp",
        "spectral.cpp",
    ],
    hdrs = [
        "constraints.hpp",
        "local_density.hpp",
        "floorplan.hpp",
        "orientation.hpp",
        "placement.hpp",
        "rudy.hpp",
        "rudy_tree.hpp",
        "spectral.hpp",
    ],
    copts = select({
        "//dreamplace/ops:openmp_macos": [
            "-Xpreprocessor",
            "-fopenmp",
        ],
        "//dreamplace/ops:openmp": ["-fopenmp"],
        "//conditions:default": ["-Wno-unknown-pragmas"],
    }),
    deps = ["//dreamplace/ops:native_kernels", "//thirdparty/flute"],
)

cc_library(
    name = "hhds",
    srcs = ["hhds.cpp"],
    hdrs = ["hhds.hpp"],
    deps = [
        ":placer",
        "@hhds//hhds:graph",
    ],
)

cc_binary(
    name = "example",
    srcs = ["example.cpp"],
    deps = [":placer"],
)

cc_library(
    name = "synthetic",
    srcs = [
        "synthetic.cpp",
        "synthetic_animation.cpp",
        "synthetic_io.cpp",
        "synthetic_png.cpp",
    ],
    hdrs = ["synthetic.hpp"],
    deps = [":hhds"],
)

cc_binary(
    name = "synthetic_place",
    srcs = ["synthetic_main.cpp"],
    deps = [":synthetic"],
)

[cc_test(
    name = "synthetic_" + kind + "_test",
    size = "small",
    timeout = "short",
    srcs = ["synthetic_test.cpp"],
    args = [kind],
    deps = [":synthetic"],
) for kind in [
    "mesh",
    "mesh_grid",
    "mesh_grid_io",
    "torus",
    "tree",
]]

