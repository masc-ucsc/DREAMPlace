// BSD-3-Clause. See LICENSE. Shared schema for C++ parameters and LiveHD --set.
H2D_INT(K, 4, "outer realization rounds")
H2D_BOOL(anchors, true, "derive edge anchors")
H2D_BOOL(order, true, "derive soft dataflow order")
H2D_BOOL(loop, true, "iterate macro and cell placement")
H2D_BOOL(pseudonets, true, "enable hop-decayed dataflow pseudo-nets")
H2D_BOOL(toposearch, true, "enable topology search")
H2D_STRING(search, "lite", "none|lite|sa")
H2D_INT(seed, 1000, "deterministic seed")
H2D_REAL(lambda0, 0.1, "initial GP order weight")
H2D_REAL(gamma, 1.15, "order weight growth per outer round")
H2D_REAL(delta, 0, "anchor tolerance in DBU; zero derives two pitches")
H2D_REAL(tau_q, 0.8, "dataflow quantile for relative order")
H2D_REAL(beta, 0.2, "dataflow pseudo-net weight")
H2D_REAL(theta_q, 0.8, "pseudo-net dataflow quantile")
H2D_REAL(alpha, 1, "RUDY cost weight")
H2D_REAL(mu, 0.01, "search displacement weight")
H2D_REAL(rho, 1, "search relative-order weight")
H2D_REAL(kappa, 10, "search anchor-deviation weight")
H2D_REAL(M, 1000000, "feasibility slack penalty")
H2D_REAL(eps, 0.001, "relative merit improvement threshold")
H2D_INT(freeze_after, 2, "earliest outer round to freeze topology")
H2D_REAL(hysteresis, 0.01, "required improvement to change topology")
H2D_STRING(anchor_mode, "exact", "exact|soft")
H2D_BOOL(order_in_lp, false, "ablation: inject relative-order constraints into LP")
H2D_BOOL(normalize_at_seed, true, "normalize search costs at the seed")
H2D_REAL(min_channel, 0, "minimum channel in DBU; zero derives from halos or pitches")
H2D_INT(hops_max, 4, "maximum register hops for dataflow")
H2D_INT(fanout_cap, 4096, "maximum fanout expanded by dataflow BFS")
H2D_INT(chains, 1, "independent serial SA chains")
H2D_INT(evals, 200, "candidate evaluations per outer round and chain")
H2D_REAL(T0, 1, "initial SA temperature")
H2D_REAL(cooling, 0.95, "SA temperature multiplier")
H2D_REAL(move_plus, 0.3, "probability of plus-sequence swap")
H2D_REAL(move_minus, 0.3, "probability of minus-sequence swap")
H2D_REAL(move_both, 0.3, "probability of swapping in both sequences")
H2D_REAL(move_flip, 0.1, "probability of orientation move")
H2D_BOOL(orient_moves, true, "allow N/FN/FS/S within LEF symmetry")
H2D_INT(seed_sa_evals, 100, "hierarchy seed shape/position annealing evaluations")
H2D_INT(bins, 32, "H2D GP and RUDY bins per axis")
H2D_REAL(target_density, 0, "zero inherits placement density")
H2D_INT(iters_per_outer, 100, "GP iterations per outer round")
H2D_BOOL(routability, false, "opt in to standard-cell density inflation")
H2D_REAL(route_cap_h, 0, "horizontal tracks per DBU; zero derives from technology")
H2D_REAL(route_cap_v, 0, "vertical tracks per DBU; zero derives from technology")
H2D_INT(threads, 1, "workers in GP; SA evaluations stay single-threaded")
H2D_REAL(pitch_x, 0, "final X snap pitch in DBU; zero uses SITE")
H2D_REAL(pitch_y, 0, "final Y snap pitch in DBU; zero uses row height")
